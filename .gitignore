# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ============================================================
# Producción de video (HyperFrames)
# ============================================================
# Los MP4 no van en git: cada re-render suma decenas de MB al historial para siempre.
# El video final se comparte por enlace (Drive / GitHub Release) — ver README.
videos/*/renders/
*.mp4
!video-presentacion/renders/*.mp4
!assets/videos/*.mp4
!videos/*/assets/**/*.mp4

# Locución generada (ElevenLabs) y su mezcla: pesa decenas de MB y se rehace con
# `python tools/voz-eleven.py <voice_id>` + `python tools/pista.py`. Los tiempos
# sí van en git (tools/tiempos-voz.json): son de lo que depende el montaje.
videos/*/assets/voz/

# Capturas de revisión (se regeneran con `npx hyperframes snapshot`)
videos/*/snapshots/

# Intermedios de construcción
videos/*/.hyperframes/
videos/*/capture/
.impeccable/
**/.impeccable/
__pycache__/

# Modelo de voz (~60 MB). Se baja con: python tools/descargar-voz.py
tools/voces/

# Indices parciales del render por partes (se regeneran con --partes N)
videos/*/index-parte-*.html

# Cache de miniaturas del Studio. Sus nombres superan el limite de ruta de
# Windows y rompen `git add` entero; ademas se regenera solo.
**/.thumbnails/
